PORT=5000
CLIENT_URL=http://localhost:8080

# MongoDB is the single source of truth for user profiles, plans, usage, chats,
# and billing history. Leave empty in local dev to auto-start an ephemeral
# in-memory MongoDB (data is lost on restart) - set a real URI for anything else.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/nova-assist-ai

# ── AI provider ──────────────────────────────────────────────────────
# "gemini" (free tier available) or "openai".
AI_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
# GEMINI_MODEL_PRO=gemini-3.5-flash

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_PRO=gpt-4o

# ── Firebase Admin SDK ───────────────────────────────────────────────
# Required to verify signed-in users server-side (chats, profile, payments).
# Firebase Console -> Project Settings -> Service accounts -> Generate new
# private key, then paste the ENTIRE downloaded JSON as one line here.
# Without this set, all authenticated routes return 500 (fail closed, not silently open).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Stripe (test mode keys for local dev) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
BASIC_FREE_COUPON=NOVA-BASIC-FREE
